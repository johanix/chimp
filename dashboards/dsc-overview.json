{
  "__inputs": [
    {
      "name": "DS_CLICKHOUSE",
      "label": "ClickHouse",
      "description": "",
      "type": "datasource",
      "pluginId": "grafana-clickhouse-datasource",
      "pluginName": "ClickHouse"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    },
    {
      "type": "datasource",
      "id": "grafana-clickhouse-datasource",
      "name": "ClickHouse",
      "version": "4.0.0"
    }
  ],
  "title": "DSC Overview",
  "uid": "dsc-overview",
  "tags": ["dsc", "dns"],
  "timezone": "",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Total QPS (all hosts, all query types)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "qps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "single" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  toStartOfInterval(timestamp, INTERVAL 5 minute) AS time,\n  sum(value) / 300.0 AS qps\nFROM dsc.observations\nWHERE dataset = 'qtype'\n  AND $__timeFilter(timestamp)\nGROUP BY time\nORDER BY time",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    },
    {
      "id": 2,
      "title": "QPS per host",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 8 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "qps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 20,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "showLegend": true, "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  toStartOfInterval(timestamp, INTERVAL 5 minute) AS time,\n  hostname,\n  sum(value) / 300.0 AS qps\nFROM dsc.observations\nWHERE dataset = 'qtype'\n  AND $__timeFilter(timestamp)\nGROUP BY time, hostname\nORDER BY time, hostname",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    },
    {
      "id": 3,
      "title": "Query type distribution",
      "type": "piechart",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 17 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right", "values": ["value", "percent"] },
        "pieType": "donut",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  multiIf(\n    key2 = '1', 'A',\n    key2 = '2', 'NS',\n    key2 = '5', 'CNAME',\n    key2 = '6', 'SOA',\n    key2 = '12', 'PTR',\n    key2 = '15', 'MX',\n    key2 = '16', 'TXT',\n    key2 = '28', 'AAAA',\n    key2 = '33', 'SRV',\n    key2 = '43', 'DS',\n    key2 = '46', 'RRSIG',\n    key2 = '47', 'NSEC',\n    key2 = '48', 'DNSKEY',\n    key2 = '50', 'NSEC3',\n    key2 = '52', 'TLSA',\n    key2 = '65', 'HTTPS',\n    key2 = '257', 'CAA',\n    concat('TYPE', key2)\n  ) AS qtype,\n  sum(value) AS total\nFROM dsc.observations\nWHERE dataset = 'qtype'\n  AND $__timeFilter(timestamp)\nGROUP BY qtype\nORDER BY total DESC",
          "format": 1,
          "queryType": "table"
        }
      ]
    },
    {
      "id": 4,
      "title": "Response codes over time",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 17 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "qps",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": { "mode": "normal", "group": "A" }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  toStartOfInterval(timestamp, INTERVAL 5 minute) AS time,\n  multiIf(\n    key2 = '0', 'NOERROR',\n    key2 = '1', 'FORMERR',\n    key2 = '2', 'SERVFAIL',\n    key2 = '3', 'NXDOMAIN',\n    key2 = '4', 'NOTIMP',\n    key2 = '5', 'REFUSED',\n    key2 = '9', 'NOTAUTH',\n    concat('RCODE', key2)\n  ) AS rcode,\n  sum(value) / 300.0 AS qps\nFROM dsc.observations\nWHERE dataset = 'rcode'\n  AND $__timeFilter(timestamp)\nGROUP BY time, rcode\nORDER BY time, rcode",
          "format": 0,
          "queryType": "timeseries"
        }
      ]
    },
    {
      "id": 5,
      "title": "Top 20 client subnets",
      "type": "table",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 26 },
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": { "type": "auto" }
          }
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "queries" },
            "properties": [
              { "id": "custom.cellOptions", "value": { "type": "gauge", "mode": "gradient" } }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "rawSql": "SELECT\n  key2 AS subnet,\n  sum(value) AS queries\nFROM dsc.observations\nWHERE dataset = 'client_subnet'\n  AND $__timeFilter(timestamp)\nGROUP BY subnet\nORDER BY queries DESC\nLIMIT 20",
          "format": 1,
          "queryType": "table"
        }
      ]
    }
  ]
}
