      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  toStartOfInterval(o.timestamp, INTERVAL 5 minute) AS time,\n  coalesce(s.country, 'Unknown') AS series,\n  sum(o.value) / 300.0 AS qps\nFROM dsc.observations o\nLEFT JOIN dsc.sites s ON s.provider = o.provider AND s.site = o.site\nWHERE o.dataset = 'qtype'\n  AND (\n    '$region' = 'world'\n    OR ('$region' = 'europe'  AND has(s.tags, 'Europe'))\n    OR ('$region' = 'nordics' AND has(s.tags, 'Nordics'))\n    OR ('$region' = 'sweden'  AND s.country_iso = 'SE')\n  )\n  AND $__timeFilter(o.timestamp)\nGROUP BY time, series\nORDER BY time, series",
          "refId": "A"
        }
      ],
      "title": "QPS by country",
      "type": "timeseries"
    },
