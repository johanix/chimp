    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "${DS_CLICKHOUSE}"
      },
      "description": "One marker per country, sized by total queries over the selected time range. This is a playground stand-in for a proper choropleth \u2014 bubbles work out of the box with lat/lon; choropleth requires a GeoJSON gazetteer config to try later.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "super-light-green",
                "value": 0
              },
              {
                "color": "green",
                "value": 10000
              },
              {
                "color": "blue",
                "value": 100000
              },
              {
                "color": "yellow",
                "value": 1000000
              },
              {
                "color": "orange",
                "value": 10000000
              },
              {
                "color": "red",
                "value": 100000000
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 23,
        "w": 13,
        "x": 0,
        "y": 0
      },
      "id": 2,
      "options": {
        "basemap": {
          "name": "Basemap",
          "type": "default"
        },
        "controls": {
          "mouseWheelZoom": true,
          "showAttribution": true,
          "showDebug": false,
          "showMeasure": false,
          "showScale": false,
          "showZoom": true
        },
        "layers": [
          {
            "config": {
              "location": {
                "latitude": "lat",
                "longitude": "lon",
                "mode": "coords"
              },
              "showLegend": true,
              "style": {
                "color": {
                  "field": "queries",
                  "fixed": "dark-blue"
                },
                "opacity": 0.7,
                "size": {
                  "field": "queries",
                  "fixed": 5,
                  "max": 30,
                  "min": 4
                },
                "symbol": {
                  "fixed": "img/icons/marker/circle.svg",
                  "mode": "fixed"
                },
                "textConfig": {
                  "fontSize": 12,
                  "offsetX": 0,
                  "offsetY": 0,
                  "textAlign": "center",
                  "textBaseline": "middle"
                }
              }
            },
            "name": "Queries per country",
            "tooltip": true,
            "type": "markers"
          }
        ],
        "tooltip": {
          "mode": "details"
        },
        "view": {
          "allLayers": true,
          "id": "fit",
          "lat": 0,
          "lon": 0,
          "noRepeat": false,
          "padding": 10,
          "zoom": 1
        }
      },
      "pluginVersion": "12.2.0",
      "targets": [
        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT\n  coalesce(s.city, 'Unknown') AS city,\n  coalesce(s.country, 'Unknown') AS country,\n  coalesce(s.country_iso, '??') AS country_iso,\n  any(s.lat) AS lat,\n  any(s.lon) AS lon,\n  sum(o.value) AS queries\nFROM dsc.observations o\nLEFT JOIN dsc.sites s ON s.provider = o.provider AND s.site = o.site\nWHERE o.dataset = 'qtype'\n  AND (\n    '$region' = 'world'\n    OR ('$region' = 'europe'  AND has(s.tags, 'Europe'))\n    OR ('$region' = 'nordics' AND has(s.tags, 'Nordics'))\n    OR ('$region' = 'sweden'  AND s.country_iso = 'SE')\n  )\n  AND $__timeFilter(o.timestamp)\n  AND s.lat != 0\nGROUP BY city, country, country_iso\nORDER BY queries DESC",
          "refId": "A"
        }
      ],
      "title": "Queries per country (bubble map)",
      "type": "geomap"
    },
    {
      "datasource": {
        "type": "grafana-clickhouse-datasource",
