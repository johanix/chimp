        {
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "${DS_CLICKHOUSE}"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT\n  toStartOfInterval(o.timestamp, INTERVAL 5 minute) AS time,\n  multiIf(\n    o.key2 = '1', 'A',\n    o.key2 = '2', 'NS',\n    o.key2 = '5', 'CNAME',\n    o.key2 = '6', 'SOA',\n    o.key2 = '12', 'PTR',\n    o.key2 = '15', 'MX',\n    o.key2 = '16', 'TXT',\n    o.key2 = '28', 'AAAA',\n    o.key2 = '33', 'SRV',\n    o.key2 = '43', 'DS',\n    o.key2 = '46', 'RRSIG',\n    o.key2 = '47', 'NSEC',\n    o.key2 = '48', 'DNSKEY',\n    o.key2 = '50', 'NSEC3',\n    o.key2 = '52', 'TLSA',\n    o.key2 = '59', 'CDS',\n    o.key2 = '60', 'CDNSKEY',\n    o.key2 = '62', 'CSYNC',\n    o.key2 = '64', 'SVCB',\n    o.key2 = '65', 'HTTPS',\n    o.key2 = '255', 'ANY',\n    o.key2 = '257', 'CAA',\n    concat('TYPE', o.key2)\n  ) AS series,\n  sum(o.value) / 300.0 AS qps\nFROM dsc.observations o\nLEFT JOIN dsc.sites s ON s.provider = o.provider AND s.site = o.site\nWHERE o.dataset = 'qtype'\n  AND (\n    '$region' = 'world'\n    OR ('$region' = 'europe'  AND has(s.tags, 'Europe'))\n    OR ('$region' = 'nordics' AND has(s.tags, 'Nordics'))\n    OR ('$region' = 'sweden'  AND s.country_iso = 'SE')\n  )\n  AND $__timeFilter(o.timestamp)\nGROUP BY time, series\nORDER BY time, series",
          "refId": "A"
        }
      ],
      "title": "QPS by qtype",
      "type": "timeseries"
    },
